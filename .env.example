# SATBase Environment Configuration Example
# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings -> Environment Variables.

# Supabase (Public Client-Side Keys - Safe for browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Public Site URL (defaults to window.location.origin if unset)
# For production set to: https://PROD_DOMAIN
VITE_PUBLIC_SITE_URL=

# Optional: Minimal Observability / Error Logging (disabled by default)
VITE_ERROR_LOGGING_ENABLED=false
VITE_ERROR_LOGGING_ENDPOINT=
